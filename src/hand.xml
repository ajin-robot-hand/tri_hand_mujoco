<mujoco model="tri_hand">
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>
  <option gravity="0 -9.81 0" integrator="implicitfast" timestep="0.002"/>

  <asset>
    <mesh name="palm" file="palm.stl" scale="0.001 0.001 0.001"/>
    <mesh name="unit" file="unit.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <default>
    <joint type="hinge" axis="1 0 0" range="-1.5708 1.5708" limited="true" damping="0.15" armature="0.01"/>

    <!-- 시각용: 원본 STL. 충돌 없음, group 1 -->
    <default class="visual">
      <geom type="mesh" density="0" contype="0" conaffinity="0" group="1"/>
    </default>

    <!-- 충돌용: 단순 프리미티브. group 3 (뷰어에서 '3' 키로 토글) -->
    <default class="collision">
      <geom density="0" contype="1" conaffinity="1" group="3"
            friction="1.0 0.005 0.0001" rgba="1 0.5 0 0.3"/>
    </default>

    <!-- XL430-W250-T 대응: kp는 기존값 유지, kv 추가로 오버슈트 억제 -->
    <position kp="12" kv="0.5" forcerange="-1.4 1.4" ctrlrange="-1.5708 1.5708"/>
  </default>

  <worldbody>
    <light pos="0 1 0" dir="0 -1 0"/>

    <!-- ===== Palm (고정) ===== -->
    <geom name="palm" class="visual" mesh="palm" rgba="0.22 0.47 0.76 1"/>
    <!-- 팜 충돌 근사 (palm.stl 단면에서 추출, 단위 m) -->
    <geom name="palm_disc"      class="collision" type="cylinder" size="0.090"
          fromto="0.030 -0.1395 0.058  0.030 -0.1280 0.058"/>
    <geom name="palm_hub"       class="collision" type="box"
          pos="0.0298 -0.0950 0.0600" size="0.0265 0.0310 0.0360"/>
    <geom name="palm_bracket_A" class="collision" type="box"
          pos="0.0298 -0.0651 0.1070" size="0.0185 0.0030 0.0170"/>
    <geom name="palm_bracket_BC" class="collision" type="box"
          pos="0.0298 -0.0655 0.0220" size="0.0550 0.0030 0.0260"/>

    <!-- ===== Finger A ===== -->
    <body name="A_link1" pos="0.0290 -0.0155 0.1100">
      <joint name="A_j1"/>
      <inertial pos="0 0 0" mass="0.07" diaginertia="2.773e-05 1.486e-05 3.344e-05"/>
      <geom class="visual" mesh="unit" euler="0 0 3.14159" rgba="0.82 0.29 0.36 1"/>
      <geom class="collision" type="box" pos="-0.00041 -0.007855 -0.00003" size="0.0207 0.03163 0.01425"/>
      <body name="A_link2" pos="0 0.0633 0">
        <joint name="A_j2"/>
        <inertial pos="0 0 0" mass="0.07" diaginertia="2.773e-05 1.486e-05 3.344e-05"/>
        <geom class="visual" mesh="unit" euler="0 0 3.14159" rgba="0.12 0.62 0.47 1"/>
        <geom class="collision" type="box" pos="-0.00041 -0.007855 -0.00003" size="0.0207 0.03163 0.01425"/>
      </body>
    </body>

    <!-- ===== Finger B ===== -->
    <body name="B_link1" pos="-0.0050 -0.0155 0.0100">
      <joint name="B_j1"/>
      <inertial pos="0 0 0" mass="0.07" diaginertia="2.773e-05 1.486e-05 3.344e-05"/>
      <geom class="visual" mesh="unit" euler="0 0 3.14159" rgba="0.82 0.29 0.36 1"/>
      <geom class="collision" type="box" pos="-0.00041 -0.007855 -0.00003" size="0.0207 0.03163 0.01425"/>
      <body name="B_link2" pos="0 0.0633 0">
        <joint name="B_j2"/>
        <inertial pos="0 0 0" mass="0.07" diaginertia="2.773e-05 1.486e-05 3.344e-05"/>
        <geom class="visual" mesh="unit" euler="0 0 3.14159" rgba="0.12 0.62 0.47 1"/>
        <geom class="collision" type="box" pos="-0.00041 -0.007855 -0.00003" size="0.0207 0.03163 0.01425"/>
      </body>
    </body>

    <!-- ===== Finger C ===== -->
    <body name="C_link1" pos="0.0650 -0.0155 0.0100">
      <joint name="C_j1"/>
      <inertial pos="0 0 0" mass="0.07" diaginertia="2.773e-05 1.486e-05 3.344e-05"/>
      <geom class="visual" mesh="unit" euler="0 0 3.14159" rgba="0.82 0.29 0.36 1"/>
      <geom class="collision" type="box" pos="-0.00041 -0.007855 -0.00003" size="0.0207 0.03163 0.01425"/>
      <body name="C_link2" pos="0 0.0633 0">
        <joint name="C_j2"/>
        <inertial pos="0 0 0" mass="0.07" diaginertia="2.773e-05 1.486e-05 3.344e-05"/>
        <geom class="visual" mesh="unit" euler="0 0 3.14159" rgba="0.12 0.62 0.47 1"/>
        <geom class="collision" type="box" pos="-0.00041 -0.007855 -0.00003" size="0.0207 0.03163 0.01425"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="A_j1_act" joint="A_j1"/>
    <position name="A_j2_act" joint="A_j2"/>
    <position name="B_j1_act" joint="B_j1"/>
    <position name="B_j2_act" joint="B_j2"/>
    <position name="C_j1_act" joint="C_j1"/>
    <position name="C_j2_act" joint="C_j2"/>
  </actuator>
</mujoco>
